# Get a free API key at https://console.groq.com/keys (no credit card, instant)
GROQ_API_KEY=your_groq_api_key_here

# Any chat model in the Groq free tier works. Good defaults:
#   llama-3.3-70b-versatile   (default -- best quality, 1,000 requests/day free)
#   llama-3.1-8b-instant      (much higher free daily limit, slightly lower quality)
GROQ_MODEL=openai/gpt-oss-120b

GROQ_BASE_URL=https://api.groq.com/openai/v1

# Where the FastAPI backend looks for data / writes output (defaults shown)
FINPROOF_DATA_DIR=data
FINPROOF_OUT_DIR=output
FINPROOF_MAX_LLM_INVESTIGATIONS=50
